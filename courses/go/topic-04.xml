    <answer><![CDATA[package main

import (
	"math"
	"strings"
	"unicode/utf8"
)

func onTeam(badge, team string) bool {
	return strings.HasPrefix(badge, team)
}

func badgeLength(badge string) int {
	return utf8.RuneCountInString(badge)
}

func clueLimit() int8 {
	return math.MaxInt8
}
