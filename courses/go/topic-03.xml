    <answer><![CDATA[package main

func order(first, second int) (int, int) {
	if first > second {
		first, second = second, first
	}
	return first, second
}

func bounds(a, b, c int) (int, int) {
	lo, hi := order(a, b)
	lo, _ = order(lo, c)
	_, hi = order(hi, c)
	return lo, hi
}

func span(a, b, c int) int {
	lo, hi := bounds(a, b, c)
	return hi - lo
}
]]></answer>
