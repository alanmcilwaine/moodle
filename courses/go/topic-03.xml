    <answer><![CDATA[package main

func allocate(age, pace int) (lane int, admitted bool) {
	if age < 8 {
		return lane, admitted
	}
	admitted = true
	lane = 2
	if pace > 40 {
		lane = 1
	}
	return lane, admitted
}
]]></answer>
