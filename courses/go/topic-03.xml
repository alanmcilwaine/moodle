    <answer><![CDATA[package main

func issue(paid, fare int) (int, bool) {
	if paid < fare {
		return 0, false
	}
	return paid - fare, true
}

func concession(paid, fare int) (int, bool) {
	return issue(paid, fare/2)
}
]]></answer>
