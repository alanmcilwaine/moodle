    <answer><![CDATA[package main

import (
	"fmt"
	"slices"
	"sync"
)

type Sector struct {
	Name     string
	Hectares int
	Rate     int
}

func (s Sector) Minutes() int {
	return s.Hectares * s.Rate
}

func sweep(sectors []Sector) []string {
	lines := make([]string, len(sectors))
	var wg sync.WaitGroup
	for i, s := range sectors {
		wg.Go(func() {
			lines[i] = fmt.Sprintf("%s %d", s.Name, s.Minutes())
		})
	}
	wg.Wait()
	slices.Sort(lines)
	return lines
}

func longest(sectors []Sector) int {
	worst := 0
	for _, s := range sectors {
		if m := s.Minutes(); m > worst {
			worst = m
		}
	}
	return worst
}
]]></answer>
