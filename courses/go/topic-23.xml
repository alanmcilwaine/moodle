    <answer><![CDATA[package main

import "sync"

func row(rate, minutes int) int {
	return rate * minutes
}

func regatta(rateOne, rateTwo, minutes int) (int, int) {
	var wg sync.WaitGroup
	var one, two int
	wg.Add(2)
	go func() {
		defer wg.Done()
		one = row(rateOne, minutes)
	}()
	go func() {
		defer wg.Done()
		two = row(rateTwo, minutes)
	}()
	wg.Wait()
	return one, two
}
]]></answer>
