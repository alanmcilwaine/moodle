    <answer><![CDATA[package main

import (
	"fmt"
	"sync"
)

type Hut struct {
	Name  string
	Bunks int
}

func entry(h Hut) string {
	return fmt.Sprintf("%s: %d", h.Name, h.Bunks)
}

func sheet(huts []Hut) []string {
	lines := make([]string, len(huts))
	var wg sync.WaitGroup
	for i, h := range huts {
		wg.Go(func() {
			lines[i] = entry(h)
		})
	}
	wg.Wait()
	return lines
}
]]></answer>
